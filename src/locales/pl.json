  "proTips": {
    "label": "Wskazówka",
    "tip-1": {
      "title": "Konsekwencja ponad intensywność",
      "content": "10 minut dziennie bije 1 godzinę raz w tygodniu. Mała, regularna praktyka buduje trwałą siłę i nawyki."
    },
    "tip-2": {
      "title": "Przypomnienie o przerwie przy biurku",
      "content": "Ustaw minutnik, aby wstać i rozciągnąć się co 30-45 minut. Twój kręgosłup potrzebuje regularnego ruchu, aby pozostać zdrowym."
    },
    "tip-3": {
      "title": "Oddychaj w rozciąganie",
      "content": "Głębokie oddychanie pomaga mięśniom się rozluźnić i zwiększa skuteczność rozciągania. Nigdy nie wstrzymuj oddechu."
    },
    "tip-4": {
      "title": "Słuchaj swojego ciała",
      "content": "Ostry ból to znak stop. Łagodny dyskomfort podczas rozciągania jest normalny, ale ból nie. Dostosuj w razie potrzeby."
    },
    "tip-5": {
      "title": "Sprawdź postawę",
      "content": "Uszy nad ramionami, ramiona nad biodrami. Sprawdź swoje ustawienie kilka razy dziennie."
    },
    "tip-6": {
      "title": "Pozycja snu ma znaczenie",
      "content": "Spanie na boku z poduszką między kolanami zmniejsza stres kręgosłupa. Unikaj spania na brzuchu."
    },
    "tip-7": {
      "title": "Postęp zajmuje czas",
      "content": "Elastyczność kręgosłupa i siła korpusu rozwijają się stopniowo. Świętuj małe zwycięstwa i zaufaj procesowi."
    },
    "tip-8": {
      "title": "Ruch poranny",
      "content": "Twój kręgosłup jest najbardziej wrażliwy rano. Rozpocznij od delikatnych ruchów przed intensywną aktywnością."
    }
  }
